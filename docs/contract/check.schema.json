{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckEnvelope",
  "description": "Top-level `mnemic check --json` document.",
  "type": "object",
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckData"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "$defs": {
    "CheckData": {
      "type": "object",
      "properties": {
        "changes": {
          "description": "Present on `check --fix`. Empty when that run wrote nothing.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/FixChange"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "required": [
        "errors",
        "warnings"
      ]
    },
    "EnvelopeCode": {
      "description": "Codes on `error.code`. Findings use `CHECK_FAILED`. The rest are fatal.",
      "type": "string",
      "enum": [
        "BAD_CONFIG",
        "CHECK_FAILED",
        "IO",
        "LOCK_HELD",
        "UNSUPPORTED_VAULT_VERSION",
        "USAGE",
        "VAULT_NOT_FOUND",
        "NESTED_VAULT",
        "NOT_FOUND",
        "AMBIGUOUS",
        "TIMELINE_DISABLED",
        "TIMELINE_HEADING_AMBIGUOUS",
        "OUTSIDE_VAULT",
        "UNKNOWN_TYPE",
        "BAD_ID",
        "ID_EXISTS",
        "SLUG_COLLISION",
        "MISSING_TEMPLATE"
      ]
    },
    "ErrorObject": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/EnvelopeCode"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/FindingCode"
        },
        "link": {
          "description": "Wikilink or typed-link text when `code` is `AMBIGUOUS`.",
          "type": [
            "string",
            "null"
          ]
        },
        "matches": {
          "description": "Sorted candidate paths when `code` is `AMBIGUOUS`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "path"
      ]
    },
    "FindingCode": {
      "description": "Per-note and later vault-wide check codes. These appear in `data.errors`.",
      "type": "string",
      "enum": [
        "BAD_FRONTMATTER",
        "BAD_ID",
        "MISSING_FIELD",
        "UNKNOWN_TYPE",
        "ALIAS_CONTACT",
        "SCHEMA_VERSION_AHEAD",
        "INVALID_PACK",
        "DUPLICATE_ID",
        "ALIAS_NOT_UNIQUE",
        "SUPERSEDED_WITHOUT_INCOMING",
        "SUPERSEDES_CYCLE",
        "BROKEN_LINK",
        "SHA256_DRIFT",
        "AMBIGUOUS"
      ]
    },
    "FixChange": {
      "description": "One key `check --fix` inserted. `old` is null. Existing values are not replaced.",
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/FixField"
        },
        "new": {
          "type": "string"
        },
        "old": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "field",
        "new"
      ]
    },
    "FixField": {
      "type": "string",
      "enum": [
        "id",
        "type"
      ]
    }
  }
}
